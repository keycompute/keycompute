# =============================================================================
# Dockerfile.web — KeyCompute 前端 WASM 多阶段构建
#
# 构建阶段：
#   1. wasm-builder — 安装 dioxus-cli，编译 WASM + 打包静态资产
#   2. runtime      — Nginx 托管 Dioxus public 产物，配置 WASM MIME 类型
#
# Dioxus 编译产物说明：
#   dx build --release 会在 target/dx/web/release/web/public/ 生成：
#   - index.html
#   - assets/         （JS、CSS、图片、字体等）
#   - *.wasm          （WebAssembly 二进制）
#   - *.js            （WASM glue 胶水代码）
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 阶段 1：wasm-builder — 编译 Dioxus WASM 前端
# ─────────────────────────────────────────────────────────────────────────────
FROM rust:1.92.0-bookworm AS wasm-builder

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    binaryen \
    && rm -rf /var/lib/apt/lists/*

# 添加 wasm32 编译目标
RUN rustup target add wasm32-unknown-unknown

# 使用轻量 sparse 索引；所有 Cargo 步骤共享后续 BuildKit cache mount。
ENV CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse
ENV CARGO_HTTP_TIMEOUT=600
ENV CARGO_NET_RETRY=10

# 安装 dioxus-cli（版本必须与项目 dioxus 版本严格匹配）
# 项目 dioxus 版本为 0.7.9（见 Cargo.toml workspace.dependencies）
# --locked 保证 dioxus-cli 自身依赖锁定
RUN --mount=type=cache,id=keycompute-web-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=keycompute-web-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    cargo install dioxus-cli@0.7.9 --locked

# 预安装 wasm-bindgen-cli（版本必须与项目 wasm-bindgen 版本严格一致）
# 项目 wasm-bindgen 版本为 0.2.114（见 Cargo.lock）
# NO_DOWNLOADS=1 模式下 dx 会对 `wasm-bindgen --version` 做精确版本匹配
RUN --mount=type=cache,id=keycompute-web-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=keycompute-web-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    cargo install wasm-bindgen-cli@0.2.114 --locked

# 预安装 esbuild（dx web 构建需要；NO_DOWNLOADS=1 禁止 dx 自动下载，必须预置到 PATH）
# 从 npm registry 下载，便于版本锁定与二进制命名
ENV ESBUILD_VERSION=0.25.0
RUN ARCH=$(uname -m | sed 's/x86_64/x64/;s/aarch64/arm64/') && \
    curl -L --proto '=https' --tlsv1.2 -sSf \
    "https://registry.npmjs.org/@esbuild/linux-${ARCH}/-/linux-${ARCH}-${ESBUILD_VERSION}.tgz" \
    -o /tmp/esbuild.tgz && \
    tar xzf /tmp/esbuild.tgz -C /tmp && \
    mv /tmp/package/bin/esbuild /usr/local/bin/esbuild && \
    chmod +x /usr/local/bin/esbuild && \
    rm -rf /tmp/esbuild.tgz /tmp/package

# Debian Bookworm 提供的 Binaryen 108 无法解析 Rust 1.92 默认生成的
# reference-types/table.fill 指令，dx 会因此跳过 wasm-opt。用官方发布版覆盖
# /usr/bin/wasm-opt，并校验架构对应的固定摘要，保证生产 Wasm 确实完成优化。
# 单次下载最多 5 分钟；重试会续传临时文件，在 45 分钟 CI 预算内收敛失败并留出编译时间。
ENV BINARYEN_VERSION=131
RUN set -eux; \
    ARCH="$(uname -m)"; \
    case "$ARCH" in \
        x86_64) SHA256="b5bf1f0eaf17c63ee588ff7a5954dc8f6ce2c26989051c66f24dfe9ece3e46db" ;; \
        aarch64) SHA256="ba991f677edd9a21d2bc96c0144bc8ac5b112d4d98a3eb266e075e22e557df2a" ;; \
        *) echo "Unsupported Binaryen architecture: $ARCH" >&2; exit 1 ;; \
    esac; \
    archive="/tmp/binaryen.tar.gz"; \
    download_url="https://github.com/WebAssembly/binaryen/releases/download/version_${BINARYEN_VERSION}/binaryen-version_${BINARYEN_VERSION}-${ARCH}-linux.tar.gz"; \
    for attempt in 1 2 3 4 5 6; do \
        if curl -L --proto '=https' --tlsv1.2 -sSf \
            --connect-timeout 20 --max-time 300 --continue-at - \
            --speed-limit 1024 --speed-time 60 \
            "$download_url" -o "$archive"; then \
            break; \
        fi; \
        if [ "$attempt" -eq 6 ]; then \
            echo "Binaryen download failed after $attempt attempts" >&2; \
            exit 1; \
        fi; \
        sleep "$attempt"; \
    done; \
    echo "$SHA256  /tmp/binaryen.tar.gz" | sha256sum -c -; \
    tar xzf /tmp/binaryen.tar.gz -C /tmp; \
    install -m 0755 "/tmp/binaryen-version_${BINARYEN_VERSION}/bin/wasm-opt" /usr/local/bin/wasm-opt; \
    rm -rf /tmp/binaryen.tar.gz "/tmp/binaryen-version_${BINARYEN_VERSION}"; \
    wasm-opt --version

WORKDIR /app

# 使用 Docker 专用 Web-only workspace，避免 dx 的 `cargo metadata` 扫描
# desktop、mobile、server 和 integration-tests。精简后的 workspace 成员
# 集合需要自己的锁文件；Cargo 不接受根 workspace 锁文件中多出的成员和依赖。
COPY prod-build/web/Cargo.toml prod-build/web/Cargo.lock ./
COPY packages/web packages/web/
COPY packages/ui packages/ui/
COPY packages/client-api packages/client-api/
COPY crates/keycompute-types crates/keycompute-types/

# dx 0.7.9 会先执行未按平台过滤的 cargo metadata。只在这个 Web-only
# workspace 中预取锁定依赖，确保后续 dx 可完全离线运行。
RUN --mount=type=cache,id=keycompute-web-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=keycompute-web-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    cargo fetch --locked

# 仅编译 Web/WASM 生产依赖，并为后续 dx build 提前验证 Rust 代码。
RUN --mount=type=cache,id=keycompute-web-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=keycompute-web-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    cargo check --locked --release \
    --package web \
    --target wasm32-unknown-unknown

# 编译前端（生产模式，在工作区根目录执行）
# dx build 产物输出到 /app/target/dx/web/release/web/public。
# --platform web 显式指定平台，Docker/CI 无图形环境下避免平台推断错误
# NO_DOWNLOADS=1 是 dioxus-cli 0.7.9 实际生效的开关（见 CliSettings::prefer_no_downloads）：
# 强制 dx 使用 PATH 中的本地工具链（固定版本的 wasm-opt/wasm-bindgen-cli/esbuild），
# 而不是构建时从 GitHub 下载（避免连接超时）。
# 此前的 DX_SKIP_WASM_OPT 会被 dx 静默忽略，仍然触发网络下载。
# API_BASE_URL 未设置时编译期缺省为空字符串（同源相对路径，经 Nginx 反代访问后端）；
# 分域部署时由 Compose build args 注入绝对 URL。
ARG API_BASE_URL=""
ENV API_BASE_URL=${API_BASE_URL}
ENV NO_DOWNLOADS=1
ENV CARGO_NET_OFFLINE=true
RUN --mount=type=cache,id=keycompute-web-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=keycompute-web-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    dx build --release --package web --platform web

# Fail the image build before the runtime stage if Dioxus changes its output
# layout or produces an incomplete Web bundle.
RUN set -eux; \
    public_dir="/app/target/dx/web/release/web/public"; \
    test -f "${public_dir}/index.html"; \
    test -n "$(find "${public_dir}" -type f -name '*.wasm' -print -quit)"; \
    test -n "$(find "${public_dir}" -type f -name '*.js' -print -quit)"

# ─────────────────────────────────────────────────────────────────────────────
# 阶段 2：runtime — Nginx 静态文件托管
# ─────────────────────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

# 删除 Nginx 默认站点配置
RUN rm -f /etc/nginx/conf.d/default.conf

# 复制 Nginx 站点配置（SPA 路由 + WASM MIME + gzip 压缩）
COPY nginx/nginx.conf /etc/nginx/nginx.conf

# 复制 dx build 产物到 Nginx 静态目录
# dx build --platform web 产物路径为：target/dx/<package_name>/release/web/public/
# package_name 来自 packages/web/Cargo.toml 中 [package].name = "web"
COPY --from=wasm-builder /app/target/dx/web/release/web/public /usr/share/nginx/html

# Nginx 默认端口
EXPOSE 80

# Local liveness must bypass runtime proxies, including with BusyBox wget.
# Keep the exec-form probe aligned with both production Compose layouts.
# Discard the body, but preserve HTTP/connection failures and stderr diagnostics.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["wget", "-Y", "off", "-q", "-O", "/dev/null", "http://127.0.0.1/"]

CMD ["nginx", "-g", "daemon off;"]
