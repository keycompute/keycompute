# =============================================================================
# .env.example — KeyCompute 环境变量配置模板
#
# 使用方法：
#   cp .env.example .env
#   # 编辑 .env 填入实际值，.env 已被 .gitignore 排除
#   docker compose up -d
#   # 本文件仅作为 Docker Compose 输入；本地 cargo run 请复制 config.example.toml，
#   # 不要在 shell 中 source .env
#
# 环境变量分类说明：
#
# 1. Docker Compose 插值变量（用于构建数据库 URL 等）
#    这些变量被 docker-compose.yml 用来组装最终的 KC__ 变量。
#    示例：POSTGRES_USER + POSTGRES_PASSWORD + POSTGRES_DB 
#         → KC__DATABASE__URL 通过 docker-compose 拼装而成
#
# 2. 应用直接读取的环境变量（KC__ 前缀或特殊名称）
#    这些变量被后端程序直接读取使用。
#    格式：KC__SECTION__KEY（双下划线分隔层级）
#    键名层级与 config.toml 中 [section] key = value 的结构对应
#    示例：KC__AUTH__JWT_SECRET 对应 [auth] jwt_secret
#
# 3. 前端编译期变量（可选）
#    用于前端构建时的编译期常量设置。
#
# 加载边界：
#   - 普通 cargo run（debug）固定为开发模式：仅读 config.toml + 代码默认值
#   - release/Docker 固定为生产模式：仅读取本文件注入的环境变量 + 代码默认值
#   - 不存在运行模式参数，两类应用配置来源不相互覆盖
#
# 警告：
#   - 生产启动会拒绝默认 JWT 密钥、缺失或无效的 Provider API Key 加密密钥；
#     配置 Redis 时还会拒绝默认节点 HMAC 密钥；首次创建 system 管理员时会拒绝默认管理员密码
#   - PostgreSQL、Redis、SMTP 和支付配置中的 change-me 值不会由应用统一拦截，
#     仍必须由运维在生产部署前逐项替换
#   - 一旦写入 Provider API Key，必须保持 KC__CRYPTO__SECRET_KEY 状态和值不变
#   - KC__AUTH__JWT_SECRET 更换后所有已签发 Token 立即失效
#   - 敏感值如密钥和密码不应提交到版本控制，应使用 .gitignore 排除 .env
# =============================================================================

# ═══════════════════════════════════════════════════════════════════════════
# 第 1 部分：Docker Compose 插值变量
# ═══════════════════════════════════════════════════════════════════════════
# 这些变量被 docker-compose.yml 用来构建更复杂的环境变量。
# docker-compose 根据这些值拼装（interpolate）最终的环境变量，
# 最终的变量值再传给应用程序。
# 
# 具体映射示例（见 docker-compose.yml 的 keycompute-server 环节）：
#   - POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB 
#     → KC__DATABASE__URL: "postgres://user:pass@postgres:5432/dbname"
#   - REDIS_PASSWORD 
#     → KC__REDIS__URL: "redis://:password@redis:6379"

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL 基础配置（被 docker-compose 用来构建 KC__DATABASE__URL）
# ─────────────────────────────────────────────────────────────────────────────
# 数据库名称
POSTGRES_DB=keycompute
# 数据库用户名
POSTGRES_USER=keycompute
# 数据库密码（示例值可运行；生产环境强烈建议使用 32 位以上随机字符串）
# 生成命令：openssl rand -base64 32
POSTGRES_PASSWORD=change-me-strong-password

# ─────────────────────────────────────────────────────────────────────────────
# Redis 基础配置（被 docker-compose 用来构建 KC__REDIS__URL）
# ─────────────────────────────────────────────────────────────────────────────
# Redis 密码（docker-compose 使用它构建 KC__REDIS__URL，生产环境强烈建议修改）
# 生成命令：openssl rand -base64 32
REDIS_PASSWORD=change-me-redis-password
# ─────────────────────────────────────────────────────────────────────────────
# 容器化服务配置（Docker Compose 服务端口和启动参数）
# ─────────────────────────────────────────────────────────────────────────────
# 前端 Web 服务对外绑定端口（Nginx 容器的 HTTP 端口）
WEB_PORT=80
# 仅 docker-compose.dev.yml 使用：本地 cargo run 连接的依赖端口
POSTGRES_PORT=5432
REDIS_PORT=6379
# 后端 API 对外端口（示例中通过 Nginx 代理，不直接暴露）
# 如需直接调试 API，可在 docker-compose.yml 中取消注释相应端口配置

# Ollama 本地模型服务配置
OLLAMA_PORT=11434
# 容器启动后自动拉取并预热的模型
OLLAMA_MODEL=gemma3:270m
# 模型保活时间（30m = 30分钟；-1 表示常驻内存）
OLLAMA_KEEP_ALIVE=30m
# 预热模型时发送的简短提示词
OLLAMA_WARMUP_PROMPT="You are KeyCompute's assistant, ready to help with any questions."

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL 复制配置（仅 docker-compose.replicas.yml 需要）
# ─────────────────────────────────────────────────────────────────────────────
# 复制角色密码（可选；不设置时默认使用 POSTGRES_PASSWORD 的值）
POSTGRES_REPLICA_PASSWORD=change-me-strong-password

# ═══════════════════════════════════════════════════════════════════════════
# 第 2 部分：应用配置环境变量（KC__ 前缀）
# ═══════════════════════════════════════════════════════════════════════════
# 这些变量被后端应用程序直接读取。
# 键名关系：环境变量 KC__SECTION__KEY 对应 [section] key = value
#
# 加载流程：
#   1. Compose 读取 `.env` 并向 release 容器注入本节变量
#   2. release 服务读取 KC__* 与顶层 APP_BASE_URL，忽略 config.toml
#   3. 普通 cargo run 的 AppConfig 不读取这些变量，固定读取 config.toml

# ─────────────────────────────────────────────────────────────────────────────
# 运行模式不是配置项：debug 是开发模式，release 是生产模式
# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.server 构建 release 可执行文件，因此 Compose 无需注入模式变量

# ─────────────────────────────────────────────────────────────────────────────
# 服务器配置
# ─────────────────────────────────────────────────────────────────────────────
# 绑定地址（容器内固定为 0.0.0.0）
# KC__SERVER__BIND_ADDR=0.0.0.0
# 监听端口（容器内固定为 3000）
# KC__SERVER__PORT=3000
# App drain deadline; supervisor grace must exceed it (plus one-second IO cleanup).
KC__SERVER__SHUTDOWN_TIMEOUT_SECS=120
KC_SERVER_STOP_GRACE_PERIOD=130s

# ─────────────────────────────────────────────────────────────────────────────
# 数据库连接配置（被 docker-compose 自动构建，不需手动设置）
# ─────────────────────────────────────────────────────────────────────────────
# KC__DATABASE__URL 由 docker-compose 根据以下值自动构建：
#   postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# 数据库连接池大小
KC__DATABASE__MAX_CONNECTIONS=10
# 数据库连接池最小值
KC__DATABASE__MIN_CONNECTIONS=2
# 高级连接参数（可选）：
# KC__DATABASE__CONNECT_TIMEOUT_SECS=30
# KC__DATABASE__IDLE_TIMEOUT_SECS=600
# KC__DATABASE__MAX_LIFETIME_SECS=1800

# ─────────────────────────────────────────────────────────────────────────────
# Redis 配置（被 docker-compose 自动构建，不需手动设置）
# ─────────────────────────────────────────────────────────────────────────────
# KC__REDIS__URL 由 docker-compose 根据 REDIS_PASSWORD 自动构建：
#   redis://:<password>@redis:6379
# Redis 连接池大小
KC__REDIS__POOL_SIZE=10
# 连接超时（秒）
KC__REDIS__CONNECT_TIMEOUT_SECS=5
# Separate bounded pools: task BRPOP / result BRPOP never use the fast pool.
# Critical pools total 10 + 10 + 10 per instance; enabling cache adds
# one critical identity connection and 10 separate disposable-cache connections.
KC__REDIS__NODE_POLL_POOL_SIZE=10
KC__REDIS__NODE_RESULT_POOL_SIZE=10
# Pool admission/recycle wait and short-command response timeouts (milliseconds).
KC__REDIS__POOL_WAIT_TIMEOUT_MS=1000
KC__REDIS__COMMAND_TIMEOUT_MS=5000

# Separate disposable cache Redis. Replace this password in production too.
CACHE_REDIS_PASSWORD=change-me-cache-redis-password
CACHE_REDIS_PORT=6380
KC__REDIS__CACHE_POOL_SIZE=10
KC__REDIS__CACHE_TIMEOUT_MS=500
# Compose defaults to its dedicated redis-cache service when CACHE_URL is unset.
# Set KC__REDIS__CACHE_URL= explicitly to disable L2 cache, or use a separate endpoint.
# KC__REDIS__CACHE_URL=redis://:cache-password@cache-redis.example:6379

# ─────────────────────────────────────────────────────────────────────────────
# 认证配置
# ─────────────────────────────────────────────────────────────────────────────
# JWT 签名密钥（生产环境必须修改，至少 32 字节；不能是纯空白）
# 生成命令：openssl rand -base64 64
# 更换后所有已签发 Token 立即失效
KC__AUTH__JWT_SECRET=change-me-in-production
# JWT 签发者标识
KC__AUTH__JWT_ISSUER=keycompute
# Token 有效期（秒）
KC__AUTH__JWT_EXPIRY_SECS=3600

# ─────────────────────────────────────────────────────────────────────────────
# 加密配置
# ─────────────────────────────────────────────────────────────────────────────
# API Key 存储加密密钥（Base64 编码的 32 字节密钥）
# 生产环境必须配置；未配置时服务拒绝启动。写入数据后必须保持配置不变。
# 生成命令：openssl rand -base64 32
# KC__CRYPTO__SECRET_KEY=<openssl rand -base64 32 的输出>

# ─────────────────────────────────────────────────────────────────────────────
# 邮件服务配置（可选）
# ─────────────────────────────────────────────────────────────────────────────
# 用于发送注册验证码、密码重置、欢迎邮件等
# 如果启用邮件服务，必须同时配置下方 APP_BASE_URL
# SMTP 服务器地址（留空表示禁用邮件）
KC__EMAIL__SMTP_HOST=
# SMTP 端口
KC__EMAIL__SMTP_PORT=465
# SMTP 用户名
KC__EMAIL__SMTP_USERNAME=
# SMTP 密码
KC__EMAIL__SMTP_PASSWORD=
# 邮件发件人地址
KC__EMAIL__FROM_ADDRESS=
# 邮件发件人显示名称
KC__EMAIL__FROM_NAME=KeyCompute
# 邮件发送超时（秒，可选，0 表示禁用 SMTP 超时）
# KC__EMAIL__TIMEOUT_SECS=30
# 是否使用 TLS 加密（可选，默认 true）
# KC__EMAIL__USE_TLS=true
# 需求收集表单接收人邮箱（可选；接收首页提交需求时需要配置）
# KC__EMAIL__REQUIREMENT_RECIPIENT=sales@example.com

# ─────────────────────────────────────────────────────────────────────────────
# 应用公开地址配置
# ─────────────────────────────────────────────────────────────────────────────
# 对外公开的前端应用基础 URL
# 用于密码重置邮件、邀请注册链接等中的公开链接
# 未设置时不生成公开链接；启用邮件服务时必须设置为当前部署的真实地址
# 非本地公开地址必须使用 https；仅 localhost / 回环地址可使用 http
# 仅供生产模式读取；开发模式使用 config.toml 中的 app_base_url
APP_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Gateway 路由配置（可选，使用默认值即可）
# ─────────────────────────────────────────────────────────────────────────────
# 请求超时时间（秒）
# KC__GATEWAY__TIMEOUT_SECS=120
# HTTP 请求超时（秒）
# KC__GATEWAY__REQUEST_TIMEOUT_SECS=120
# 流式请求超时（秒）
# KC__GATEWAY__STREAM_TIMEOUT_SECS=600
# 最大重试次数
# KC__GATEWAY__MAX_RETRIES=3
# 是否启用 fallback（当主 Provider 失败时尝试备选）
# KC__GATEWAY__ENABLE_FALLBACK=true
# 管理端原始追踪查询允许的最大时间范围（小时）
# KC__GATEWAY__MONITORING_RAW_MAX_HOURS=24
# 自动 Provider Account 真实推理探测；0=禁用，启用后会产生上游调用与费用
# KC__GATEWAY__ACCOUNT_PROBE_INTERVAL_SECS=0
# KC__GATEWAY__ACCOUNT_PROBE_CONCURRENCY=4

# ─────────────────────────────────────────────────────────────────────────────
# 读写分离路由配置（可选，使用默认值即可）
# ─────────────────────────────────────────────────────────────────────────────
# 以下变量在使用 docker-compose.replicas.yml 时生效，
# 通过 KC__DATABASE_READ_URLS 指定读库列表（由 compose 内联构建，无需手动设置）
# KC__DATABASE_READ_URLS=postgres://user:pass@replica:5432/db
# 路由策略：round_robin / random / weighted
KC__DATABASE_ROUTING__STRATEGY=round_robin
# 读库权重（仅 weighted 策略生效，逗号分隔）
# KC__DATABASE_ROUTING__READ_WEIGHTS=1,2
# 读库连接池大小
KC__DATABASE_READ__MAX_CONNECTIONS=10
KC__DATABASE_READ__MIN_CONNECTIONS=1
# 读库连接池高级参数（可选）
# KC__DATABASE_READ__CONNECT_TIMEOUT_SECS=5
# KC__DATABASE_READ__IDLE_TIMEOUT_SECS=600
# KC__DATABASE_READ__ACQUIRE_TIMEOUT_SECS=10
# KC__DATABASE_READ__MAX_LIFETIME_SECS=1800
# 额外重试次数
KC__DATABASE_ROUTING__RETRY_ATTEMPTS=2
# 熔断时间（毫秒）
KC__DATABASE_ROUTING__CIRCUIT_BREAK_MS=30000
# 读库不可用时是否回退到写库（默认 true，与代码默认值一致）
KC__DATABASE_ROUTING__FALLBACK_TO_WRITE=true
# 健康检查间隔（秒，0=禁用）
KC__DATABASE_ROUTING__HEALTH_CHECK_INTERVAL_SECS=15

# ─────────────────────────────────────────────────────────────────────────────
# 默认系统管理员（首次启动时自动创建）
# ─────────────────────────────────────────────────────────────────────────────
# 注意：该配置不在 config.toml 中（config.toml 无 [admin] 段）
# 仅通过环境变量读取
# 生产环境首次创建 system 管理员前必须修改（至少 12 个字符且不能是纯空白），否则服务拒绝启动
# system 管理员创建完成后，后续重启可删除该一次性引导密码
KC__DEFAULT_ADMIN_EMAIL=admin@keycompute.local
KC__DEFAULT_ADMIN_PASSWORD=change-me-admin-password

# ─────────────────────────────────────────────────────────────────────────────
# 节点网关配置（Node Gateway）
# ─────────────────────────────────────────────────────────────────────────────
# 用于个人 PC 节点接入，支持 Ollama 本地模型执行
# 节点通过 node-token 客户端连接，主动轮询任务并提交结果
#
# 节点注册 HMAC 签名密钥（生产环境配置 Redis 时必须修改，至少 16 字节）
# 用于签发一次性节点注册 token，非共享 token。
# 用户需要先申请 → 管理员审批 → 用户获取唯一 token → 注册节点。
# 生成命令：openssl rand -base64 32
KC__NODE_GATEWAY__REGISTRATION_TOKEN_SECRET=change-me-node-registration-token-secret
# 会话 TTL（秒），节点会话有效期，默认 300（5 分钟）
# 超过此时间未心跳的会话将被标记为过期
# KC__NODE_GATEWAY__SESSION_TTL_SECS=300
# 心跳间隔（秒），node-token 客户端发送心跳的间隔，默认 30
# KC__NODE_GATEWAY__HEARTBEAT_INTERVAL_SECS=30
# 轮询超时（秒），节点长轮询领取任务的最长等待时间，默认 30
# KC__NODE_GATEWAY__POLL_TIMEOUT_SECS=30
# 任务 deadline 超时（秒），任务必须在 deadline 内完成，默认 120（2 分钟）
# KC__NODE_GATEWAY__TASK_DEADLINE_SECS=120
# 完成宽限期（秒），任务过期后允许提交结果的时间，默认 60（1 分钟）
# KC__NODE_GATEWAY__COMPLETE_GRACE_SECS=60
# 节点失败阈值，节点连续失败次数达到此值后被排除（excluded），默认 3
# KC__NODE_GATEWAY__NODE_FAILURE_THRESHOLD=3
# 任务失败阈值，单个任务失败重试次数上限，默认 3
# KC__NODE_GATEWAY__TASK_FAILURE_THRESHOLD=3
# Sweeper 心跳 TTL（秒），超过此时间未心跳的 online 节点标记为 offline，默认 600（10 分钟）
# KC__NODE_GATEWAY__SWEEPER_HEARTBEAT_TTL_SECS=600
# Sweeper 补推间隔（秒），创建超过此时间的 queued 任务补推到 Redis，默认 10
# KC__NODE_GATEWAY__SWEEPER_REPUSH_INTERVAL_SECS=10
#
# 安全警告：
#   - 轮换 KC__NODE_GATEWAY__REGISTRATION_TOKEN_SECRET 会使已复制但尚未消费的注册 token 失效；
#     已批准用户需重新获取 token，现有节点会话不受影响
#   - 生产环境强烈建议使用 openssl rand -base64 32 生成独立随机密钥
#   - 此密钥用于 HMAC-SHA256 签名，不直接暴露给节点

# ═══════════════════════════════════════════════════════════════════════════
# 第 3 部分：支付配置（可选）
# ═══════════════════════════════════════════════════════════════════════════
# 如需启用支付功能，配置相应的支付服务商环境变量

# ─────────────────────────────────────────────────────────────────────────────
# 支付宝配置（可选）
# ─────────────────────────────────────────────────────────────────────────────
# 支付宝应用 ID
# ALIPAY_APP_ID=change-me-alipay-appid
# 应用私钥（PEM 格式）
# ALIPAY_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# 支付宝公钥（PEM 格式，用于验签）
# ALIPAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# 轮换期历史支付宝公钥（JSON 字符串数组，仅用于验证存量回调）
# ALIPAY_PREVIOUS_PUBLIC_KEYS_JSON=["-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"]
# 支付宝环境（sandbox 或 production）
# ALIPAY_ENV=production
# 支付结果异步通知 URL（必填）
# ALIPAY_NOTIFY_URL=https://app.example.com/api/v1/payments/notify/alipay
# 支付成功后的同步返回 URL（可选）
# ALIPAY_RETURN_URL=https://app.example.com/payment/result
# 支付超时时间（分钟，默认 30）
# ALIPAY_TIMEOUT_MINUTES=30

# ─────────────────────────────────────────────────────────────────────────────
# 微信支付配置（可选）
# ─────────────────────────────────────────────────────────────────────────────
# 微信支付 App ID
# KC__PAYMENT__WECHATPAY__APPID=wx1234567890abcdef
# 微信支付商户号
# KC__PAYMENT__WECHATPAY__MCHID=change-me-mchid
# 商户 API 证书序列号
# KC__PAYMENT__WECHATPAY__MERCHANT_SERIAL_NO=change-me-serial-no
# 商户 API 私钥（PKCS#8 PEM，换行可写为 \n）
# KC__PAYMENT__WECHATPAY__MERCHANT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# API v3 密钥（恰好 32 字节）
# KC__PAYMENT__WECHATPAY__API_V3_KEY=change-me-32-byte-api-v3-key
# 微信支付公钥 ID 与公钥
# KC__PAYMENT__WECHATPAY__WECHATPAY_PUBLIC_KEY_ID=PUB_KEY_ID_...
# KC__PAYMENT__WECHATPAY__WECHATPAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# 轮换期历史回调密钥（JSON，仅用于验签/解密存量回调）
# KC__PAYMENT__WECHATPAY__PREVIOUS_CALLBACK_KEYS_JSON=[{"public_key_id":"PUB_KEY_ID_OLD","public_key":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----","api_v3_key":"0123456789abcdef0123456789abcdef"}]
# 微信支付异步通知 URL
# KC__PAYMENT__WECHATPAY__NOTIFY_URL=https://app.example.com/api/v1/payments/notify/wechatpay
# 订单超时时间（分钟，默认 15）
# KC__PAYMENT__WECHATPAY__TIMEOUT_MINUTES=15

# ═══════════════════════════════════════════════════════════════════════════
# 第 4 部分：前端编译期配置（可选）
# ═══════════════════════════════════════════════════════════════════════════
# 这些变量在前端构建时（dx build）被编译到二进制中

# ─────────────────────────────────────────────────────────────────────────────
# Web 前端 API 配置
# ─────────────────────────────────────────────────────────────────────────────
# 前端调用后端 API 的基础 URL（编译期常量）
# 未设置时使用当前页面 origin；Dioxus 开发服务器会将 /api、/v1、/health
# 代理到 127.0.0.1:3000，生产构建则与前端同源
# API_BASE_URL=https://api.example.com

# Process-local generation in-flight and bounded queue budgets.
KC__GATEWAY__ADMISSION__GLOBAL_LIMIT=256
KC__GATEWAY__ADMISSION__TENANT_LIMIT=32
KC__GATEWAY__ADMISSION__ACCOUNT_LIMIT=32
KC__GATEWAY__ADMISSION__GLOBAL_QUEUE=128
KC__GATEWAY__ADMISSION__TENANT_QUEUE=16
KC__GATEWAY__ADMISSION__ACCOUNT_QUEUE=16
KC__GATEWAY__ADMISSION__QUEUE_TIMEOUT_MS=1000

# Advisory routing snapshots (authoritative account admission is never cached).
KC__GATEWAY__ROUTING_CAPACITY__CANDIDATE_LIMIT=32
KC__GATEWAY__ROUTING_CAPACITY__CACHE_ENTRIES=4096
KC__GATEWAY__ROUTING_CAPACITY__TTL_MS=100
KC__GATEWAY__ROUTING_CAPACITY__CONCURRENCY=16
KC__GATEWAY__ROUTING_CAPACITY__TIMEOUT_MS=1000

# Retained payload budget; leave non-payload RSS/headroom outside this limit.
KC__GATEWAY__MANAGED_MEMORY_MIB=512
